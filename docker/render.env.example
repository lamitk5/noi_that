APP_NAME="Mộc An Furniture"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://YOUR-SERVICE.onrender.com
APP_KEY=base64:YOUR_APP_KEY
TRUSTED_PROXIES=*

DB_CONNECTION=mysql
DB_HOST=YOUR-AIVEN-HOST
DB_PORT=YOUR-AIVEN-PORT
DB_DATABASE=defaultdb
DB_USERNAME=avnadmin
DB_PASSWORD=THAY_BANG_MAT_KHAU_AIVEN
MYSQL_ATTR_SSL_CA=/etc/secrets/ca.pem

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=sync
LOG_CHANNEL=stderr
LOG_LEVEL=info

PORT=10000
# migrate chỉ thêm bảng/cột mới. Không dùng migrate:fresh và không bật RUN_SEEDERS
# (PictureProductSeeder xóa toàn bộ sản phẩm).
RUN_MIGRATIONS=true
RUN_SEEDERS=false
# Render → Disks: gắn Persistent Disk, Mount Path = /var/www/storage
# Ảnh admin tải lên nằm trong thư mục này và còn sau mỗi lần deploy.

SEED_ADMIN_NAME="Shop Admin"
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=THAY_BANG_MAT_KHAU_RIENG

# Bắt buộc cấu hình SMTP thật: mã OTP (đăng ký / quên mật khẩu) KHÔNG còn hiển thị trên màn hình ở production.
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
# Không đặt MAIL_SCHEME=null trên Render: biến môi trường là chuỗi "null" và SMTP sẽ lỗi.
MAIL_USERNAME=your-account@gmail.com
MAIL_PASSWORD=YOUR_GMAIL_APP_PASSWORD
MAIL_FROM_ADDRESS=your-account@gmail.com
MAIL_FROM_NAME="Mộc An Furniture"

# SMS OTP cho tài khoản đăng ký bằng số điện thoại (esms | speedsms | twilio)
SMS_PROVIDER=
ESMS_API_KEY=
ESMS_SECRET_KEY=
ESMS_BRANDNAME=
SPEEDSMS_ACCESS_TOKEN=
SPEEDSMS_SENDER=
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Trợ lý AI tư vấn sản phẩm (lấy key tại https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Đăng nhập Google (redirect mặc định: ${APP_URL}/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Tích hợp MoMo (URL return/IPN được sinh tự động: /thanh-toan/momo/return và /api/payment/momo/ipn)
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_VERIFY_SSL=true

# Tích hợp VNPAY (return: /thanh-toan/vnpay/return, IPN: /api/payment/vnpay/ipn)
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=

# Tích hợp GHN (bắt buộc nếu muốn tính phí ship thật)
GHN_TOKEN=
GHN_SHOP_ID=
GHN_FROM_DISTRICT_ID=1442
GHN_FROM_WARD_CODE=20101
GHN_VERIFY_SSL=true
